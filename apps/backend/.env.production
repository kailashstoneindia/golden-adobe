# =============================================================
# Golden Abode Backend — Production (Railway)
# Paste these into Railway → backend service → Variables.
# Do NOT commit this file to git.
# =============================================================

NODE_ENV=production
PORT=3000

# ─── PostgreSQL (Railway linked service) ──────────────────────
# Replace "Postgres" with your Railway Postgres service name if different.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ─── Redis (Railway linked service) ───────────────────────────
# Replace "Redis" with your Railway Redis service name if different.
REDIS_URL=${{Redis.REDIS_URL}}

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=e71802f867ec3b8afdb5f349d91e482430a261e0c1456cf0d86dbf2fce643b09
JWT_ACCESS_EXPIRES_IN=15m
JWT_ONBOARDING_SECRET=c526364ca73e81b4ffb19742afa8303dbfea6564e8c75c950cb298dbe86ed5ad
JWT_ONBOARDING_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── MSG91 ────────────────────────────────────────────────────
USE_MSG91_SMS=false
MSG91_AUTH_KEY=382941a742e84c7185bf2941a742e84c
MSG91_TEMPLATE_ID=64b7f3e1d2c3b4a5f6e7d8c9
MSG91_SENDER_ID=GLDNAB

# ─── Rate limiting ────────────────────────────────────────────
THROTTLE_OTP_SEND_LIMIT=3
THROTTLE_OTP_SEND_TTL=3600
THROTTLE_OTP_VERIFY_LIMIT=5
THROTTLE_OTP_VERIFY_TTL=600
