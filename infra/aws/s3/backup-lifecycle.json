{
  "Rules": [
    {
      "ID": "ExpireDatabaseBackupsAfter35Days",
      "Status": "Enabled",
      "Filter": { "Prefix": "postgres/" },
      "Expiration": { "Days": 35 }
    },
    {
      "ID": "ExpireDeployBundlesAfter30Days",
      "Status": "Enabled",
      "Filter": { "Prefix": "deploy-bundles/" },
      "Expiration": { "Days": 30 }
    },
    {
      "ID": "DropOldVersionsAfter3Days",
      "Status": "Enabled",
      "Filter": { "Prefix": "" },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 3 }
    },
    {
      "ID": "CleanExpiredMarkersAndStalledUploads",
      "Status": "Enabled",
      "Filter": { "Prefix": "" },
      "Expiration": { "ExpiredObjectDeleteMarker": true },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    }
  ]
}
