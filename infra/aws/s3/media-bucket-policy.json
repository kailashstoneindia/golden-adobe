{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontMayReadVariantsOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>/variants/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/<MEDIA_DISTRIBUTION_ID>"
        }
      }
    }
  ]
}
