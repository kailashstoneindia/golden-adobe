# Production environment for the box. NOT written by hand: render-env.sh builds
# /opt/golden-abode/.env from SSM Parameter Store, one parameter per line below,
# named /golden-abode/prod/<NAME> (SecureString for anything secret).
#
# The container wiring (DB_HOST, REDIS_HOST, MEILI_HOST, PORT, NODE_ENV,
# WORKER_MODE) is fixed in docker-compose.prod.yml and is deliberately NOT here.

# --- required (render-env.sh refuses to continue without these) -----------------
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
AWS_REGION=ap-south-1
DB_PASS=
JWT_ACCESS_SECRET=
JWT_ONBOARDING_SECRET=
ADMIN_REGISTRATION_SECRET=
MEILI_MASTER_KEY=
# Product media (decision 0033). No access keys: the instance role supplies them.
S3_MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=https://media.example.com
# Shared with the media Lambda; at least 32 characters.
MEDIA_CALLBACK_SECRET=
BACKUP_BUCKET=

# --- optional --------------------------------------------------------------------
DB_NAME=golden_abode
DB_USER=postgres
MEILI_SEARCH_KEY=
SEARCH_ENGINE=meilisearch
USE_MSG91_SMS=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GOLDEN
JWT_ACCESS_EXPIRES_IN=15m
# Publishes a CloudWatch metric after each backup so an alarm can notice a gap.
BACKUP_METRIC_ENABLED=true
# Add --apply once the dry-run output of the weekly sweep has been reviewed.
MEDIA_SWEEP_ARGS=
