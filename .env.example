# =============================================================
# Golden Abode — Root Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =============================================================

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golden_abode
DB_USER=postgres
DB_PASS=postgres

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────
# Access token secret — min 32 random chars in production
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
# Access token expiry (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Onboarding token secret (for pre-registration flow)
JWT_ONBOARDING_SECRET=change_me_onboarding_secret_min_32_chars
JWT_ONBOARDING_EXPIRES_IN=15m

# Refresh token TTL in days
REFRESH_TOKEN_TTL_DAYS=30

# ─── Admin registration ───────────────────────────────────────
# Required to create the first (and later) admin accounts via /auth/admin/register
ADMIN_REGISTRATION_SECRET=change_me_admin_registration_secret_min_16_chars

# ─── MSG91 ────────────────────────────────────────────────────
# Set to true only after MSG91 DLT template is approved
USE_MSG91_SMS=false
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=GOLDEN

# ─── Rate Limiting ────────────────────────────────────────────
# Max OTP send attempts per hour per phone
THROTTLE_OTP_SEND_LIMIT=3
THROTTLE_OTP_SEND_TTL=3600

# Max OTP verify failed attempts per 10 min per phone
THROTTLE_OTP_VERIFY_LIMIT=5
THROTTLE_OTP_VERIFY_TTL=600

# ─── Search (Phase 6, decision 0021) ──────────────────────────
# Engine kill switch: 'meilisearch' | 'postgres'
# 'postgres' is a supported permanent mode, not a degraded one — it is also
# admin's primary search path (decision 0019).
SEARCH_ENGINE=meilisearch

# Local Docker default. On Railway this becomes the private networking host,
# e.g. http://meilisearch.railway.internal:7700 — an env change, never a code change.
MEILI_HOST=http://127.0.0.1:7700

# Full-access key (indexing + admin). NEVER ship this in a client bundle.
MEILI_MASTER_KEY=local_dev_master_key_change_me

# Search-only key. This is the one that may be handed to a client for direct
# autocomplete calls (decision 0019). Generate from the master key.
MEILI_SEARCH_KEY=

MEILI_PRODUCTS_INDEX=products

# Process role: 'all' | 'api' | 'worker'
#   all    — HTTP + the search outbox drain in one process (default)
#   api    — HTTP only; something else owns the drain
#   worker — the drain only
# Splitting the worker onto its own Railway service is this env var, not a refactor.
WORKER_MODE=all

# Demo environments only. When "true", the migration 20261002100000-load-demo-catalog-and-vendors
# loads the demo catalog, vendors and inventory into a BLANK database on deploy (decision 0031).
# Leave unset everywhere else (CI, local, real production). Must be set BEFORE the deploy that
# first runs the migration: it is recorded as done even when skipped.
# LOAD_DEMO_DATA=true

# ─── Product media (decision 0033) ────────────────────────────
# Leave S3_MEDIA_BUCKET unset to run with media disabled (the app boots; the
# media endpoints answer 503). Local values below match docker-compose MinIO.
# On AWS: unset S3_ENDPOINT / S3_FORCE_PATH_STYLE / S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY (the EC2 instance role supplies credentials) and set
# MEDIA_PUBLIC_BASE_URL to the CloudFront domain.
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=golden-abode-media
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=golden_dev
S3_SECRET_ACCESS_KEY=golden_dev_secret
# Browser-reachable endpoint for presigned uploads, only if the API runs inside
# Docker and reaches S3 under a different hostname than the browser does.
# S3_PRESIGN_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/golden-abode-media
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_PER_PRODUCT=20
MEDIA_PRESIGN_TTL_SECONDS=300
# Shared with the media Lambda; signs its processing-result callback.
# At least 32 characters. Required when a bucket is set in production.
MEDIA_CALLBACK_SECRET=local_dev_media_callback_secret_change_me
# A row still "processing" after this long is shown as failed (computed on read).
MEDIA_PROCESSING_TIMEOUT_SECONDS=600
